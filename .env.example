# =============================================================================
# House Rental Management System — Docker Compose Environment Template
# =============================================================================
# Hướng dẫn:
#   1. Copy file này thành .env ở thư mục gốc:  cp .env.example .env
#   2. Thay đổi SQL_SA_PASSWORD và JWT_SECRET_KEY trước khi deploy thật
#   3. Khởi chạy trọn bộ 3 dịch vụ:             docker compose up --build
# =============================================================================

# --- SQL Server 2022 ---
# Yêu cầu mật khẩu mạnh: >= 8 ký tự, gồm chữ hoa, chữ thường, chữ số và ký tự đặc biệt
SQL_SA_PASSWORD=HouseRental@2026!
SQL_DB_NAME=APIDemo
SQL_PORT=1433
MSSQL_PID=Express

# --- ASP.NET Core 10 Web API ---
# Dùng Development khi chạy local/demo (bật Swagger UI tại http://localhost:5066/swagger)
# Đổi sang Production khi triển khai thật sau Reverse Proxy HTTPS
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5066
ALLOWED_HOSTS=*
AUTO_SEED_DATABASE=true
DISABLE_HTTPS_REDIRECTION=true

# Khóa bí mật ký JWT (tối thiểu 32 ký tự) — BẮT BUỘC đổi khi lên Production
JWT_SECRET_KEY=ChangeMe_SuperSecret_HouseRental_JwtKey_2026_Min32Chars!
JWT_ISSUER=http://localhost:5066
JWT_AUDIENCE=http://localhost:3000
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Origin của Frontend được phép gọi API kèm HttpOnly Cookie (CORS)
CORS_ALLOWED_ORIGIN=http://localhost:3000

# --- Next.js 16 Frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5066/api
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:5066
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Đặt false ở Production để ẩn các module demo/mock phụ
NEXT_PUBLIC_ENABLE_DEMO_MODULES=false
# Đặt true khi ảnh upload nằm trên localhost:5066; đặt false khi dùng CDN/domain HTTPS thật
NEXT_PUBLIC_IMAGE_UNOPTIMIZED=true
